{
  // Modo "image" — simples e confiável.
  // O OSRM roda como stack Docker separada (docker-compose.osrm.yml).
  // O devcontainer acessa via host.docker.internal:5000, que no
  // Docker Desktop (Windows e Mac) sempre resolve para o host.
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "name": "cardapio-geo-api",
  "customizations": {
    "vscode": {
      "extensions": [
        // ── O Núcleo do Rust (Suas escolhas) ─────────────────────
    "rust-lang.rust-analyzer",
    "vadimcn.vscode-lldb",
    "tamasfe.even-better-toml",
    "serayuzgur.crates",
    "usernamehw.errorlens",
    "fill-labs.dependi",

    // ── Ambiente de Subsistema e Versionamento ───────────────
    "ms-vscode-remote.remote-wsl",
    "eamodio.gitlens",

    // ── Integração Contínua e Infraestrutura ─────────────────
    "github.vscode-github-actions",

    // ── Ferramentas de Compilação de Baixo Nível e Qualidade ─
    "dtsvet.vscode-wasm",
    "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "rust-analyzer.cargo.target": "wasm32-wasip1",
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.check.extraArgs": [
          "--",
          "-D",
          "warnings"
        ],
        "rust-analyzer.inlayHints.parameterHints.enable": true,
        "rust-analyzer.inlayHints.typeHints.enable": true,
        "editor.formatOnSave": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "geo-api (Spin)",
      "onAutoForward": "notify"
    }
  },
  // Aponta spin para o OSRM rodando no host via Docker Desktop.
  // host.docker.internal é injetado automaticamente pelo Docker Desktop
  // em Windows e Mac — não precisa de configuração extra.
  "remoteEnv": {
    "SPIN_VARIABLE_OSRM_BASE": "http://localhost:5000/route/v1/driving"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteUser": "vscode"
}